Vagrant.configure("2") do |config|
  nodes = [
    { name: "node1", ip: "192.168.56.11" },  # Manager
    { name: "node2", ip: "192.168.56.12" },
    { name: "node3", ip: "192.168.56.13" },
    { name: "node4", ip: "192.168.56.14" },
    { name: "node5", ip: "192.168.56.15" }   # IoTDB Node
  ]

  nodes.each do |node|
    config.vm.define node[:name] do |n|
      n.vm.box = "gusztavvargadr/ubuntu-server"
      n.vm.hostname = node[:name]
      n.vm.network "private_network", ip: node[:ip]

      # Forwarded Ports
      if node[:name] == "node5"
        n.vm.network "forwarded_port", guest: 6667, host: 6667  # IoTDB port
        n.vm.network "forwarded_port", guest: 8181, host: 8181  # IoTDB Web UI
      elsif node[:name] == "node1"
        n.vm.network "forwarded_port", guest: 443, host: 443
        n.vm.network "forwarded_port", guest: 6379, host: 6379
        n.vm.network "forwarded_port", guest: 5000, host: 5000
        n.vm.network "forwarded_port", guest: 9090, host: 9090
        n.vm.network "forwarded_port", guest: 3000, host: 3000
        n.vm.network "forwarded_port", guest: 8080, host: 8080
      end

      # Provision Script (applied to all nodes)
      n.vm.provision "shell", inline: <<-SHELL
        apt-get update
        apt-get install -y docker.io python3-pip curl git binfmt-support qemu-user-static
        pip3 install flask

        # Enable QEMU for cross-platform builds
        docker run --privileged --rm tonistiigi/binfmt --install all

        # Install Docker Buildx plugin for ARM64
        mkdir -p ~/.docker/cli-plugins
        curl -L https://github.com/docker/buildx/releases/download/v0.11.2/buildx-v0.11.2.linux-arm64 -o ~/.docker/cli-plugins/docker-buildx
        chmod +x ~/.docker/cli-plugins/docker-buildx

        # Test buildx (optional)
        ~/.docker/cli-plugins/docker-buildx version || echo "Buildx install failed"

        systemctl start docker
        systemctl enable docker
        usermod -aG docker vagrant

        if [ "#{node[:name]}" = "node5" ]; then
          apt-get install -y lvm2
          if ! lsblk | grep -q sdb1; then
            echo ',,83' | sfdisk -q -D /dev/sdb
            mkfs.ext4 /dev/sdb1
          fi
          mkdir -p /var/lib/iotdb
          grep -q sdb1 /etc/fstab || echo '/dev/sdb1 /var/lib/iotdb ext4 defaults 0 0' >> /etc/fstab
          mount /var/lib/iotdb
        fi
      SHELL

      n.vm.provider "vmware_desktop" do |v|
        v.gui = false
        v.memory = 8192
        v.cpus = 2
      end
    end
  end
end