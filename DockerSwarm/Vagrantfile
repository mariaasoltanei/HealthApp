Vagrant.configure("2") do |config|
  nodes = [
    { name: "node1", ip: "192.168.56.11" },  # Manager
    { name: "node2", ip: "192.168.56.12" },
    { name: "node3", ip: "192.168.56.13" },
    { name: "node4", ip: "192.168.56.14" },
    { name: "node5", ip: "192.168.56.15" }   # IoTDB Node
  ]

  nodes.each do |node|
    config.vm.define node[:name] do |n|
      n.vm.box = "gusztavvargadr/ubuntu-server"
      n.vm.hostname = node[:name]
      n.vm.network "private_network", ip: node[:ip]
      n.vm.network "forwarded_port", guest: 6667, host: 6667 if node[:name] == "node5"  # IoTDB port
      n.vm.network "forwarded_port", guest: 8181, host: 8181 if node[:name] == "node5"  # IoTDB Web UI
      if node[:name] == "node1"
        n.vm.network "forwarded_port", guest: 443, host: 443    # NGINX (TLS entry point)
        n.vm.network "forwarded_port", guest: 5000, host: 5000  # Flask (HTTP for testing)
        n.vm.network "forwarded_port", guest: 9090, host: 9090  # Prometheus
        n.vm.network "forwarded_port", guest: 3000, host: 3000  # Grafana
        n.vm.network "forwarded_port", guest: 8080, host: 8080  # cAdvisor
      end

      n.vm.provider "vmware_desktop" do |v|
        v.gui = false
        v.memory = 1024
        v.cpus = 1
      end

      n.vm.provision "shell", inline: <<-SHELL
        apt-get update
        apt-get install -y docker.io python3-pip
        pip3 install flask
        systemctl start docker
        systemctl enable docker
        usermod -aG docker vagrant
      SHELL
    end
  end
end
